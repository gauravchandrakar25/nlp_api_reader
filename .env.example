# ==========================================
# Root Environment Configuration Template
# ==========================================

# -----------------
# API Server Config
# -----------------
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# -----------------
# Supabase Configuration
# -----------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh... # Server-side only (never expose to web)
SUPABASE_ANON_KEY=eyJh...

# Secret key used with PostgreSQL pgcrypto (pgp_sym_decrypt / pgp_sym_encrypt)
# to encrypt and decrypt sensitive API keys and tokens in the database
SUPABASE_DB_ENCRYPTION_KEY=super-secret-master-encryption-key-for-credentials-32b

# -----------------
# Optional LLM Config (For dynamic OpenAI/Claude fallback)
# -----------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
